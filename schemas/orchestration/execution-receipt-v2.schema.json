{
  "$defs": {
    "ProviderName": {
      "enum": [
        "todoist",
        "notion"
      ],
      "title": "ProviderName",
      "type": "string"
    },
    "RecoveryInstruction": {
      "additionalProperties": false,
      "properties": {
        "evidence_reference": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence Reference",
          "type": "string"
        },
        "instruction": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderName"
        },
        "required_actor": {
          "default": "Ryan",
          "title": "Required Actor",
          "type": "string"
        },
        "safe_to_retry": {
          "default": false,
          "title": "Safe To Retry",
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "provider",
        "instruction",
        "evidence_reference"
      ],
      "title": "RecoveryInstruction",
      "type": "object"
    },
    "TransactionStateV2": {
      "enum": [
        "prepared",
        "authorization_validated",
        "applying",
        "verifying",
        "verified",
        "retry_pending",
        "partially_applied",
        "compensating",
        "compensated",
        "failed",
        "manual_recovery_required",
        "simulated"
      ],
      "title": "TransactionStateV2",
      "type": "string"
    }
  },
  "$id": "https://atlas-ros.local/schemas/orchestration/execution-receipt-v2.schema.json",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "title": "Action Id",
      "type": "string"
    },
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "applied": {
      "title": "Applied",
      "type": "boolean"
    },
    "attempt_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Attempt Counts",
      "type": "object"
    },
    "authorization_digest": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Authorization Digest",
      "type": "string"
    },
    "authorization_id": {
      "title": "Authorization Id",
      "type": "string"
    },
    "command_id": {
      "title": "Command Id",
      "type": "string"
    },
    "compensation_result": {
      "default": "",
      "title": "Compensation Result",
      "type": "string"
    },
    "contract_version": {
      "const": 2,
      "default": 2,
      "title": "Contract Version",
      "type": "integer"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "evidence_digests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Digests",
      "type": "array"
    },
    "execution_plan_digest": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Execution Plan Digest",
      "type": "string"
    },
    "execution_plan_id": {
      "title": "Execution Plan Id",
      "type": "string"
    },
    "final_transaction_state": {
      "$ref": "#/$defs/TransactionStateV2"
    },
    "hierarchy_verified": {
      "default": false,
      "title": "Hierarchy Verified",
      "type": "boolean"
    },
    "idempotency_digests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Idempotency Digests",
      "type": "array"
    },
    "notion_link_verified": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notion Link Verified"
    },
    "objective_done_when_verified": {
      "default": false,
      "title": "Objective Done When Verified",
      "type": "boolean"
    },
    "operations_applied": {
      "items": {
        "type": "string"
      },
      "title": "Operations Applied",
      "type": "array"
    },
    "operations_requested": {
      "items": {
        "type": "string"
      },
      "title": "Operations Requested",
      "type": "array"
    },
    "provider_object_references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provider Object References",
      "type": "array"
    },
    "readback_results": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Readback Results",
      "type": "object"
    },
    "readback_verified": {
      "title": "Readback Verified",
      "type": "boolean"
    },
    "receipt_digest": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Receipt Digest",
      "type": "string"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "recovery_instructions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecoveryInstruction"
      },
      "title": "Recovery Instructions",
      "type": "array"
    },
    "section_routing_verified": {
      "default": false,
      "title": "Section Routing Verified",
      "type": "boolean"
    },
    "simulation": {
      "default": false,
      "title": "Simulation",
      "type": "boolean"
    },
    "transaction_id": {
      "title": "Transaction Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "transaction_id",
    "command_id",
    "action_id",
    "correlation_id",
    "execution_plan_id",
    "execution_plan_digest",
    "authorization_id",
    "authorization_digest",
    "actor",
    "operations_requested",
    "operations_applied",
    "final_transaction_state",
    "receipt_digest",
    "applied",
    "readback_verified"
  ],
  "title": "ExecutionReceiptV2",
  "type": "object"
}
