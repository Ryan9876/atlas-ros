{
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/execution/pipeline-run-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_model_version": {
      "const": "7.0",
      "default": "7.0",
      "title": "Authority Model Version",
      "type": "string"
    },
    "authorization_id": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ],
      "default": null,
      "title": "Authorization Id"
    },
    "blockers": {
      "default": [],
      "items": {"type": "string"},
      "title": "Blockers",
      "type": "array"
    },
    "capability_catalog_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capability Catalog Digest",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {"format": "date-time", "type": "string"},
        {"type": "null"}
      ],
      "default": null,
      "title": "Completed At"
    },
    "completion_state": {
      "default": "completed",
      "enum": ["completed", "blocked", "failed"],
      "title": "Completion State",
      "type": "string"
    },
    "contract_catalog_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Catalog Digest",
      "type": "string"
    },
    "contract_id": {
      "const": "atlas.pipeline-run-envelope",
      "default": "atlas.pipeline-run-envelope",
      "title": "Contract Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "execution_transaction_id": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ],
      "default": null,
      "title": "Execution Transaction Id"
    },
    "initializer_version": {"title": "Initializer Version", "type": "string"},
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "policy_registry_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Registry Digest",
      "type": "string"
    },
    "provider_operation_receipts": {
      "default": [],
      "items": {"type": "string"},
      "title": "Provider Operation Receipts",
      "type": "array"
    },
    "readback_results": {
      "default": [],
      "items": {"type": "string"},
      "title": "Readback Results",
      "type": "array"
    },
    "reconciliation_receipt": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ],
      "default": null,
      "title": "Reconciliation Receipt"
    },
    "release_version": {"title": "Release Version", "type": "string"},
    "run_id": {"format": "uuid", "title": "Run Id", "type": "string"},
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "stage_digests": {
      "additionalProperties": {"type": "string"},
      "title": "Stage Digests",
      "type": "object"
    },
    "started_at": {"format": "date-time", "title": "Started At", "type": "string"},
    "warnings": {
      "default": [],
      "items": {"type": "string"},
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "correlation_id",
    "release_version",
    "source_commit",
    "initializer_version",
    "contract_catalog_digest",
    "policy_registry_digest",
    "capability_catalog_digest",
    "input_digest"
  ],
  "title": "PipelineRunEnvelope",
  "type": "object"
}
