{
  "$defs": {
    "PlannedProviderOperation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "provider": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "target": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "sequence",
        "provider",
        "action",
        "target",
        "payload_digest",
        "idempotency_key"
      ],
      "title": "PlannedProviderOperation",
      "type": "object"
    }
  },
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/execution/proposed-execution-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "contract_id": {
      "const": "atlas.proposed-execution-plan",
      "default": "atlas.proposed-execution-plan",
      "title": "Contract Id",
      "type": "string"
    },
    "operations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlannedProviderOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_graph_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Graph Digest",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "source_graph_digest",
    "plan_digest"
  ],
  "title": "ProposedExecutionPlan",
  "type": "object"
}
