{
  "$defs": {
    "AtlasCommandType": {
      "enum": [
        "delegate",
        "update",
        "waiting-on",
        "blocked",
        "received",
        "approved",
        "complete",
        "cancel"
      ],
      "title": "AtlasCommandType",
      "type": "string"
    },
    "AtlasCommandV1": {
      "additionalProperties": false,
      "properties": {
        "command_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Digest",
          "type": "string"
        },
        "command_type": {
          "$ref": "#/$defs/AtlasCommandType"
        },
        "contract_id": {
          "const": "atlas.command",
          "default": "atlas.command",
          "title": "Contract Id",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fields",
          "type": "object"
        },
        "idempotency_identity": {
          "title": "Idempotency Identity",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CommandSourceRefV1"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "command_type",
        "source",
        "command_digest",
        "idempotency_identity"
      ],
      "title": "AtlasCommandV1",
      "type": "object"
    },
    "AuthoritativeSystem": {
      "enum": [
        "github",
        "notion",
        "todoist",
        "sqlite",
        "other"
      ],
      "title": "AuthoritativeSystem",
      "type": "string"
    },
    "CommandSourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "atlas.command-source-ref",
          "default": "atlas.command-source-ref",
          "title": "Contract Id",
          "type": "string"
        },
        "parent_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Task Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_command_text": {
          "title": "Source Command Text",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_provider": {
          "$ref": "#/$defs/AuthoritativeSystem"
        },
        "source_task_id": {
          "title": "Source Task Id",
          "type": "string"
        },
        "source_task_revision": {
          "title": "Source Task Revision",
          "type": "string"
        }
      },
      "required": [
        "source_provider",
        "source_task_id",
        "source_task_revision",
        "source_command_text",
        "source_digest"
      ],
      "title": "CommandSourceRefV1",
      "type": "object"
    },
    "ConfidenceAssessment": {
      "properties": {
        "missing_data": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MissingDataIndicator"
          },
          "title": "Missing Data",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        }
      },
      "required": [
        "score",
        "rationale"
      ],
      "title": "ConfidenceAssessment",
      "type": "object"
    },
    "MissingDataIndicator": {
      "properties": {
        "field_name": {
          "title": "Field Name",
          "type": "string"
        },
        "material": {
          "default": false,
          "title": "Material",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field_name",
        "reason"
      ],
      "title": "MissingDataIndicator",
      "type": "object"
    },
    "ProvenanceRecord": {
      "properties": {
        "observed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "origin": {
          "$ref": "#/$defs/ValueOrigin"
        },
        "schema_version": {
          "default": "advisory-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "origin"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "ValueOrigin": {
      "enum": [
        "observed",
        "inferred",
        "configured",
        "simulated",
        "unknown"
      ],
      "title": "ValueOrigin",
      "type": "string"
    }
  },
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/operational-awareness/task-update-lifecycle-normalization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountable_party": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accountable Party"
    },
    "actionable_transition": {
      "title": "Actionable Transition",
      "type": "boolean"
    },
    "ambiguity": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Ambiguity",
      "type": "array"
    },
    "blockers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "classification": {
      "$ref": "#/$defs/AtlasCommandType"
    },
    "completion_criteria": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Completion Criteria",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceAssessment"
    },
    "contract_id": {
      "const": "atlas.task-update-lifecycle-normalization",
      "default": "atlas.task-update-lifecycle-normalization",
      "title": "Contract Id",
      "type": "string"
    },
    "delegate_due": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delegate Due"
    },
    "evidence": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "expected_outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Outcome"
    },
    "follow_up_checkpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Follow Up Checkpoint"
    },
    "normalization_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalization Digest",
      "type": "string"
    },
    "proposed_command": {
      "$ref": "#/$defs/AtlasCommandV1"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceRecord"
      },
      "title": "Provenance",
      "type": "array"
    },
    "responsible_party": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Responsible Party"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CommandSourceRefV1"
    }
  },
  "required": [
    "source",
    "classification",
    "proposed_command",
    "actionable_transition",
    "confidence",
    "normalization_digest"
  ],
  "title": "TaskUpdateLifecycleNormalizationV1",
  "type": "object"
}
