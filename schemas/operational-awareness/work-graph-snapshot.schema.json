{
  "$defs": {
    "AuthoritativeSystem": {
      "enum": [
        "github",
        "notion",
        "todoist",
        "sqlite",
        "other"
      ],
      "title": "AuthoritativeSystem",
      "type": "string"
    },
    "OperationalRecordRefV1": {
      "additionalProperties": false,
      "properties": {
        "authoritative_system": {
          "$ref": "#/$defs/AuthoritativeSystem"
        },
        "canonical_record_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Record Id",
          "type": "string"
        },
        "canonical_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Url"
        },
        "contract_id": {
          "const": "atlas.operational-record-ref",
          "default": "atlas.operational-record-ref",
          "title": "Contract Id",
          "type": "string"
        },
        "parent_record_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Record Id"
        },
        "record_type": {
          "$ref": "#/$defs/OperationalRecordType"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "record_type",
        "canonical_record_id",
        "authoritative_system",
        "source_revision",
        "source_digest"
      ],
      "title": "OperationalRecordRefV1",
      "type": "object"
    },
    "OperationalRecordType": {
      "enum": [
        "action_record",
        "execution_step",
        "delegated_work",
        "portfolio_project",
        "risk_or_blocker",
        "todoist_task",
        "provider_transaction_receipt",
        "decision_record",
        "review_record"
      ],
      "title": "OperationalRecordType",
      "type": "string"
    },
    "WorkGraphEdgeV1": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "atlas.work-graph-edge",
          "default": "atlas.work-graph-edge",
          "title": "Contract Id",
          "type": "string"
        },
        "edge_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Edge Digest",
          "type": "string"
        },
        "edge_type": {
          "title": "Edge Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "target_record_id": {
          "title": "Target Record Id",
          "type": "string"
        }
      },
      "required": [
        "source_record_id",
        "target_record_id",
        "edge_type",
        "edge_digest"
      ],
      "title": "WorkGraphEdgeV1",
      "type": "object"
    },
    "WorkGraphNodeV1": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "atlas.work-graph-node",
          "default": "atlas.work-graph-node",
          "title": "Contract Id",
          "type": "string"
        },
        "effective_state": {
          "title": "Effective State",
          "type": "string"
        },
        "node_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Node Digest",
          "type": "string"
        },
        "protected_history": {
          "default": false,
          "title": "Protected History",
          "type": "boolean"
        },
        "record_reference": {
          "$ref": "#/$defs/OperationalRecordRefV1"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "record_reference",
        "effective_state",
        "node_digest"
      ],
      "title": "WorkGraphNodeV1",
      "type": "object"
    }
  },
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/operational-awareness/work-graph-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "atlas.work-graph-snapshot",
      "default": "atlas.work-graph-snapshot",
      "title": "Contract Id",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/WorkGraphEdgeV1"
      },
      "title": "Edges",
      "type": "array"
    },
    "graph_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Digest",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/WorkGraphNodeV1"
      },
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "nodes",
    "edges",
    "graph_digest"
  ],
  "title": "WorkGraphSnapshotV1",
  "type": "object"
}
