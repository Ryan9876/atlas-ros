{
  "$defs": {
    "AtlasCommandType": {
      "enum": [
        "delegate",
        "update",
        "waiting-on",
        "blocked",
        "received",
        "approved",
        "complete",
        "cancel"
      ],
      "title": "AtlasCommandType",
      "type": "string"
    },
    "AuthoritativeSystem": {
      "enum": [
        "github",
        "notion",
        "todoist",
        "sqlite",
        "other"
      ],
      "title": "AuthoritativeSystem",
      "type": "string"
    },
    "CommandSourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "atlas.command-source-ref",
          "default": "atlas.command-source-ref",
          "title": "Contract Id",
          "type": "string"
        },
        "parent_task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Task Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_command_text": {
          "title": "Source Command Text",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_provider": {
          "$ref": "#/$defs/AuthoritativeSystem"
        },
        "source_task_id": {
          "title": "Source Task Id",
          "type": "string"
        },
        "source_task_revision": {
          "title": "Source Task Revision",
          "type": "string"
        }
      },
      "required": [
        "source_provider",
        "source_task_id",
        "source_task_revision",
        "source_command_text",
        "source_digest"
      ],
      "title": "CommandSourceRefV1",
      "type": "object"
    }
  },
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/operational-awareness/atlas-command.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Digest",
      "type": "string"
    },
    "command_type": {
      "$ref": "#/$defs/AtlasCommandType"
    },
    "contract_id": {
      "const": "atlas.command",
      "default": "atlas.command",
      "title": "Contract Id",
      "type": "string"
    },
    "fields": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Fields",
      "type": "object"
    },
    "idempotency_identity": {
      "title": "Idempotency Identity",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CommandSourceRefV1"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    }
  },
  "required": [
    "command_type",
    "source",
    "command_digest",
    "idempotency_identity"
  ],
  "title": "AtlasCommandV1",
  "type": "object"
}
