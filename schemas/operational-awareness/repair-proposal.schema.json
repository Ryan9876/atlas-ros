{
  "$defs": {
    "AuthoritativeSystem": {
      "enum": [
        "github",
        "notion",
        "todoist",
        "sqlite",
        "other"
      ],
      "title": "AuthoritativeSystem",
      "type": "string"
    },
    "OperationalRecordRefV1": {
      "additionalProperties": false,
      "properties": {
        "authoritative_system": {
          "$ref": "#/$defs/AuthoritativeSystem"
        },
        "canonical_record_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Canonical Record Id",
          "type": "string"
        },
        "canonical_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Url"
        },
        "contract_id": {
          "const": "atlas.operational-record-ref",
          "default": "atlas.operational-record-ref",
          "title": "Contract Id",
          "type": "string"
        },
        "parent_record_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Record Id"
        },
        "record_type": {
          "$ref": "#/$defs/OperationalRecordType"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "record_type",
        "canonical_record_id",
        "authoritative_system",
        "source_revision",
        "source_digest"
      ],
      "title": "OperationalRecordRefV1",
      "type": "object"
    },
    "OperationalRecordType": {
      "enum": [
        "action_record",
        "execution_step",
        "delegated_work",
        "portfolio_project",
        "risk_or_blocker",
        "todoist_task",
        "provider_transaction_receipt",
        "decision_record",
        "review_record"
      ],
      "title": "OperationalRecordType",
      "type": "string"
    }
  },
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/operational-awareness/repair-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "atlas.repair-proposal",
      "default": "atlas.repair-proposal",
      "title": "Contract Id",
      "type": "string"
    },
    "exact_affected_records": {
      "items": {
        "$ref": "#/$defs/OperationalRecordRefV1"
      },
      "title": "Exact Affected Records",
      "type": "array"
    },
    "expected_provider_operations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Expected Provider Operations",
      "type": "array"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "idempotency_identity": {
      "title": "Idempotency Identity",
      "type": "string"
    },
    "intended_final_state": {
      "title": "Intended Final State",
      "type": "string"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "proposal_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Digest",
      "type": "string"
    },
    "readback_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Readback Requirements",
      "type": "array"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "reversibility": {
      "title": "Reversibility",
      "type": "string"
    },
    "risk_classification": {
      "title": "Risk Classification",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "exact_affected_records",
    "intended_final_state",
    "reason",
    "preconditions",
    "expected_provider_operations",
    "reversibility",
    "risk_classification",
    "readback_requirements",
    "idempotency_identity",
    "proposal_digest"
  ],
  "title": "RepairProposalV1",
  "type": "object"
}
