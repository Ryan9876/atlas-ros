{
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/operational-awareness/clarification-resolution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {"const": "atlas.clarification-resolution", "default": "atlas.clarification-resolution", "type": "string"},
    "schema_version": {"const": "1.0", "default": "1.0", "type": "string"},
    "capture_id": {"minLength": 1, "type": "string"},
    "correlation_id": {"minLength": 1, "type": "string"},
    "analysis_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "original_instruction": {"minLength": 1, "type": "string"},
    "clarification_question": {"minLength": 1, "type": "string"},
    "user_response": {"minLength": 1, "type": "string"},
    "normalized_instruction": {"minLength": 1, "type": "string"},
    "ambiguity_category": {
      "enum": [
        "none",
        "suspected_transcription_error",
        "incorrect_relationship_or_connector_word",
        "missing_target",
        "missing_project_or_application_name",
        "unrecognized_possible_proper_noun",
        "multiple_plausible_targets",
        "missing_ownership",
        "missing_expected_outcome",
        "missing_completion_criteria",
        "conflicting_dates",
        "conflicting_priorities",
        "ambiguous_pronoun",
        "ambiguous_delegation",
        "ambiguous_action_versus_project",
        "ambiguous_request_versus_informational_note"
      ],
      "type": "string"
    },
    "resolved_at": {"type": ["string", "null"]},
    "idempotency_identity": {"minLength": 1, "type": "string"},
    "routing_allowed": {"const": false, "default": false, "type": "boolean"},
    "execution_authorized": {"const": false, "default": false, "type": "boolean"},
    "provider_write_count": {"const": 0, "default": 0, "type": "integer"},
    "todoist_write_count": {"const": 0, "default": 0, "type": "integer"},
    "resolution_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "capture_id",
    "correlation_id",
    "analysis_digest",
    "original_instruction",
    "clarification_question",
    "user_response",
    "normalized_instruction",
    "ambiguity_category",
    "idempotency_identity",
    "resolution_digest"
  ],
  "title": "ClarificationResolutionV1",
  "type": "object"
}
