{
  "$defs": {
    "AuthorityLevel": {
      "enum": [
        "primary",
        "authoritative_application",
        "governed_internal",
        "user_provided",
        "inferred",
        "unverified"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "active",
        "superseded",
        "expired",
        "retracted"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "ProvenanceHop": {
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityLevel"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "unverified"
        }
      },
      "required": [
        "source",
        "authority",
        "observed_at",
        "content_hash"
      ],
      "title": "ProvenanceHop",
      "type": "object"
    },
    "RecordKind": {
      "enum": [
        "evidence_envelope",
        "context_snapshot",
        "prediction_record",
        "recommendation_record",
        "decision_record",
        "learning_event",
        "claim_record",
        "assumption_record",
        "inference_rule",
        "inference_trace",
        "governance_policy_record",
        "policy_evaluation_record",
        "decision_governance_record"
      ],
      "title": "RecordKind",
      "type": "string"
    },
    "RecordRef": {
      "properties": {
        "integrity_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Integrity Hash",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecordKind"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "integrity_hash"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "verified",
        "partial",
        "unverified",
        "rejected"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence_after": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence After",
      "type": "number"
    },
    "confidence_before": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence Before",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "delta_analysis": {
      "minLength": 1,
      "title": "Delta Analysis",
      "type": "string"
    },
    "eligibility_reason": {
      "minLength": 1,
      "title": "Eligibility Reason",
      "type": "string"
    },
    "integrity_hash": {
      "default": "",
      "title": "Integrity Hash",
      "type": "string"
    },
    "kind": {
      "const": "learning_event",
      "default": "learning_event",
      "title": "Kind",
      "type": "string"
    },
    "learning_eligible": {
      "title": "Learning Eligible",
      "type": "boolean"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "active"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Links",
      "type": "array"
    },
    "model_version": {
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "observed_outcome": {
      "minLength": 1,
      "title": "Observed Outcome",
      "type": "string"
    },
    "pattern_updates": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Pattern Updates",
      "type": "array"
    },
    "prediction_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceHop"
      },
      "title": "Provenance",
      "type": "array"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "observed_outcome",
    "delta_analysis",
    "confidence_before",
    "confidence_after",
    "model_version",
    "learning_eligible",
    "eligibility_reason"
  ],
  "title": "LearningEvent",
  "type": "object"
}
