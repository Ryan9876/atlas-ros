{
  "$defs": {
    "AuthorityLevel": {
      "enum": [
        "primary",
        "authoritative_application",
        "governed_internal",
        "user_provided",
        "inferred",
        "unverified"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "active",
        "superseded",
        "expired",
        "retracted"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "ProvenanceHop": {
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityLevel"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "unverified"
        }
      },
      "required": [
        "source",
        "authority",
        "observed_at",
        "content_hash"
      ],
      "title": "ProvenanceHop",
      "type": "object"
    },
    "RecordKind": {
      "enum": [
        "evidence_envelope",
        "context_snapshot",
        "prediction_record",
        "recommendation_record",
        "decision_record",
        "learning_event",
        "claim_record",
        "assumption_record",
        "inference_rule",
        "inference_trace",
        "governance_policy_record",
        "policy_evaluation_record",
        "decision_governance_record"
      ],
      "title": "RecordKind",
      "type": "string"
    },
    "RecordRef": {
      "properties": {
        "integrity_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Integrity Hash",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecordKind"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "integrity_hash"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "verified",
        "partial",
        "unverified",
        "rejected"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Outcome"
    },
    "assumptions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "calibration_error": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Error"
    },
    "confidence_high": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence High",
      "type": "number"
    },
    "confidence_low": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence Low",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "integrity_hash": {
      "default": "",
      "title": "Integrity Hash",
      "type": "string"
    },
    "kind": {
      "const": "prediction_record",
      "default": "prediction_record",
      "title": "Kind",
      "type": "string"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "active"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Links",
      "type": "array"
    },
    "prediction": {
      "minLength": 1,
      "title": "Prediction",
      "type": "string"
    },
    "probability": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Probability",
      "type": "number"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceHop"
      },
      "title": "Provenance",
      "type": "array"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "prediction",
    "probability",
    "confidence_low",
    "confidence_high",
    "expires_at",
    "evidence_refs"
  ],
  "title": "PredictionRecord",
  "type": "object"
}
