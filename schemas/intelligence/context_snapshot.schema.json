{
  "$defs": {
    "AuthorityLevel": {
      "enum": [
        "primary",
        "authoritative_application",
        "governed_internal",
        "user_provided",
        "inferred",
        "unverified"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "active",
        "superseded",
        "expired",
        "retracted"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "ProvenanceHop": {
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityLevel"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "unverified"
        }
      },
      "required": [
        "source",
        "authority",
        "observed_at",
        "content_hash"
      ],
      "title": "ProvenanceHop",
      "type": "object"
    },
    "RecordKind": {
      "enum": [
        "evidence_envelope",
        "context_snapshot",
        "prediction_record",
        "recommendation_record",
        "decision_record",
        "learning_event"
      ],
      "title": "RecordKind",
      "type": "string"
    },
    "RecordRef": {
      "properties": {
        "integrity_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Integrity Hash",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecordKind"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "integrity_hash"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "verified",
        "partial",
        "unverified",
        "rejected"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_objective": {
      "minLength": 1,
      "title": "Active Objective",
      "type": "string"
    },
    "available_authorities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Available Authorities",
      "type": "array"
    },
    "constraints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_horizon": {
      "minLength": 1,
      "title": "Decision Horizon",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "integrity_hash": {
      "default": "",
      "title": "Integrity Hash",
      "type": "string"
    },
    "kind": {
      "const": "context_snapshot",
      "default": "context_snapshot",
      "title": "Kind",
      "type": "string"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "active"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Links",
      "type": "array"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceHop"
      },
      "title": "Provenance",
      "type": "array"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "session_lineage": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Session Lineage",
      "type": "array"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "user_state": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "User State",
      "type": "object"
    }
  },
  "required": [
    "active_objective",
    "decision_horizon"
  ],
  "title": "ContextSnapshot",
  "type": "object"
}
