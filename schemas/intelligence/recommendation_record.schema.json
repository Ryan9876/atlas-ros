{
  "$defs": {
    "AuthorityLevel": {
      "enum": [
        "primary",
        "authoritative_application",
        "governed_internal",
        "user_provided",
        "inferred",
        "unverified"
      ],
      "title": "AuthorityLevel",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "active",
        "superseded",
        "expired",
        "retracted"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "ProvenanceHop": {
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityLevel"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "unverified"
        }
      },
      "required": [
        "source",
        "authority",
        "observed_at",
        "content_hash"
      ],
      "title": "ProvenanceHop",
      "type": "object"
    },
    "RecommendationOption": {
      "properties": {
        "expected_benefit": {
          "minLength": 1,
          "title": "Expected Benefit",
          "type": "string"
        },
        "expected_risk": {
          "minLength": 1,
          "title": "Expected Risk",
          "type": "string"
        },
        "option": {
          "minLength": 1,
          "title": "Option",
          "type": "string"
        }
      },
      "required": [
        "option",
        "expected_benefit",
        "expected_risk"
      ],
      "title": "RecommendationOption",
      "type": "object"
    },
    "RecordKind": {
      "enum": [
        "evidence_envelope",
        "context_snapshot",
        "prediction_record",
        "recommendation_record",
        "decision_record",
        "learning_event"
      ],
      "title": "RecordKind",
      "type": "string"
    },
    "RecordRef": {
      "properties": {
        "integrity_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Integrity Hash",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecordKind"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "integrity_hash"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "verified",
        "partial",
        "unverified",
        "rejected"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "items": {
        "$ref": "#/$defs/RecommendationOption"
      },
      "minItems": 1,
      "title": "Alternatives",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "context_ref": {
      "$ref": "#/$defs/RecordRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "expected_benefit": {
      "minLength": 1,
      "title": "Expected Benefit",
      "type": "string"
    },
    "expected_risk": {
      "minLength": 1,
      "title": "Expected Risk",
      "type": "string"
    },
    "integrity_hash": {
      "default": "",
      "title": "Integrity Hash",
      "type": "string"
    },
    "kind": {
      "const": "recommendation_record",
      "default": "recommendation_record",
      "title": "Kind",
      "type": "string"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "active"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Links",
      "type": "array"
    },
    "provenance": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceHop"
      },
      "title": "Provenance",
      "type": "array"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "recommendation": {
      "minLength": 1,
      "title": "Recommendation",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "recommendation",
    "alternatives",
    "rationale",
    "expected_benefit",
    "expected_risk",
    "confidence",
    "evidence_refs",
    "context_ref"
  ],
  "title": "RecommendationRecord",
  "type": "object"
}
