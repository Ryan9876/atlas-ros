{
  "$defs": {
    "ContractKind": {"enum": ["capture", "reasoning", "knowledge", "management", "execution_plan", "execution_receipt", "reconciliation"], "title": "ContractKind", "type": "string"},
    "ManagementActionV1": {
      "additionalProperties": false,
      "properties": {
        "action_id": {"maxLength": 256, "minLength": 1, "title": "Action Id", "type": "string"},
        "done_when": {"maxLength": 10000, "minLength": 1, "title": "Done When", "type": "string"},
        "execution_ready": {"default": false, "title": "Execution Ready", "type": "boolean"},
        "horizon": {"enum": ["current", "next", "conditional", "future", "blocked"], "title": "Horizon", "type": "string"},
        "objective": {"maxLength": 10000, "minLength": 1, "title": "Objective", "type": "string"},
        "owner": {"default": "", "maxLength": 200, "title": "Owner", "type": "string"},
        "semantic_provenance": {"default": [], "items": {"type": "string"}, "title": "Semantic Provenance", "type": "array"},
        "semantic_role": {"$ref": "#/$defs/SemanticRole"},
        "source_instruction_role": {"maxLength": 100, "minLength": 1, "title": "Source Instruction Role", "type": "string"},
        "title": {"maxLength": 500, "minLength": 1, "title": "Title", "type": "string"},
        "trigger": {"default": "", "maxLength": 2000, "title": "Trigger", "type": "string"}
      },
      "required": ["action_id", "title", "objective", "done_when", "semantic_role", "horizon", "source_instruction_role"],
      "title": "ManagementActionV1",
      "type": "object"
    },
    "SemanticRole": {"enum": ["parent_business_outcome", "current_business_action", "delegated_action", "conditional_action", "evaluation_only", "audit_only", "provider_control", "reference_only"], "title": "SemanticRole", "type": "string"}
  },
  "$id": "https://atlas-ros.local/schemas/management-package-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"maxLength": 256, "minLength": 1, "title": "Artifact Id", "type": "string"},
    "artifact_type": {"maxLength": 200, "minLength": 1, "title": "Artifact Type", "type": "string"},
    "assumptions": {"default": [], "items": {"type": "string"}, "title": "Assumptions", "type": "array"},
    "audit_requirements": {"default": [], "items": {"type": "string"}, "title": "Audit Requirements", "type": "array"},
    "conditional_outcomes": {"default": [], "items": {"$ref": "#/$defs/ManagementActionV1"}, "title": "Conditional Outcomes", "type": "array"},
    "configuration_digest": {"maxLength": 64, "minLength": 64, "title": "Configuration Digest", "type": "string"},
    "contract_kind": {"$ref": "#/$defs/ContractKind", "default": "management"},
    "contract_version": {"const": 3, "default": 3, "title": "Contract Version", "type": "integer"},
    "correlation_id": {"format": "uuid", "title": "Correlation Id", "type": "string"},
    "created_at": {"format": "date-time", "title": "Created At", "type": "string"},
    "delegated_outcomes": {"default": [], "items": {"$ref": "#/$defs/ManagementActionV1"}, "title": "Delegated Outcomes", "type": "array"},
    "evaluation_context": {"default": [], "items": {"type": "string"}, "title": "Evaluation Context", "type": "array"},
    "execution_candidates": {"default": [], "items": {"$ref": "#/$defs/ManagementActionV1"}, "title": "Execution Candidates", "type": "array"},
    "execution_constraints": {"default": [], "items": {"type": "string"}, "title": "Execution Constraints", "type": "array"},
    "intent_partition_digest": {"maxLength": 64, "minLength": 64, "title": "Intent Partition Digest", "type": "string"},
    "lifecycle_status": {"enum": ["draft", "decision_required", "structurally_complete"], "title": "Lifecycle Status", "type": "string"},
    "module_registry_digest": {"maxLength": 64, "minLength": 64, "title": "Module Registry Digest", "type": "string"},
    "owner": {"default": "", "maxLength": 200, "title": "Owner", "type": "string"},
    "package_digest": {"maxLength": 64, "minLength": 64, "title": "Package Digest", "type": "string"},
    "planning_model_id": {"maxLength": 200, "minLength": 1, "title": "Planning Model Id", "type": "string"},
    "planning_model_version": {"maxLength": 100, "minLength": 1, "title": "Planning Model Version", "type": "string"},
    "planning_registry_digest": {"maxLength": 64, "minLength": 64, "title": "Planning Registry Digest", "type": "string"},
    "primary_outcome": {"maxLength": 10000, "minLength": 1, "title": "Primary Outcome", "type": "string"},
    "primary_outcome_done_when": {"maxLength": 10000, "minLength": 1, "title": "Primary Outcome Done When", "type": "string"},
    "reference_context": {"default": [], "items": {"type": "string"}, "title": "Reference Context", "type": "array"},
    "responsibility": {"maxLength": 2000, "minLength": 1, "title": "Responsibility", "type": "string"},
    "semantic_provenance": {"additionalProperties": {"items": {"type": "string"}, "type": "array"}, "title": "Semantic Provenance", "type": "object"},
    "source_component": {"default": "engines.management_structure", "title": "Source Component", "type": "string"},
    "source_knowledge_reference": {"maxLength": 500, "minLength": 1, "title": "Source Knowledge Reference", "type": "string"},
    "source_reasoning_reference": {"maxLength": 500, "minLength": 1, "title": "Source Reasoning Reference", "type": "string"},
    "unresolved_items": {"default": [], "items": {"type": "string"}, "title": "Unresolved Items", "type": "array"},
    "workstream": {"default": "", "maxLength": 200, "title": "Workstream", "type": "string"}
  },
  "required": ["correlation_id", "artifact_id", "artifact_type", "planning_model_id", "planning_model_version", "source_reasoning_reference", "source_knowledge_reference", "responsibility", "primary_outcome", "primary_outcome_done_when", "lifecycle_status", "planning_registry_digest", "module_registry_digest", "configuration_digest", "intent_partition_digest", "package_digest"],
  "title": "ManagementPackageV3",
  "type": "object"
}
