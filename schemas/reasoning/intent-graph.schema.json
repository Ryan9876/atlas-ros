{
  "$defs": {
    "IntentEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_type": {
          "enum": [
            "depends_on",
            "constrains",
            "enables",
            "blocks"
          ],
          "title": "Edge Type",
          "type": "string"
        },
        "source_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Node Id",
          "type": "string"
        }
      },
      "required": [
        "source_node_id",
        "target_node_id",
        "edge_type"
      ],
      "title": "IntentEdge",
      "type": "object"
    },
    "IntentNode": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "execution_candidate": {
          "default": false,
          "title": "Execution Candidate",
          "type": "boolean"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "enum": [
            "outcome",
            "checkpoint",
            "constraint",
            "decision",
            "action"
          ],
          "title": "Node Type",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "node_type",
        "title"
      ],
      "title": "IntentNode",
      "type": "object"
    }
  },
  "$id": "https://github.com/Ryan9876/atlas-ros/schemas/reasoning/intent-graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "const": "atlas.intent-graph",
      "default": "atlas.intent-graph",
      "title": "Contract Id",
      "type": "string"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/IntentEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "graph_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Digest",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/IntentNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "primary_node_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Primary Node Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "primary_node_id",
    "nodes",
    "graph_digest"
  ],
  "title": "IntentGraph",
  "type": "object"
}
